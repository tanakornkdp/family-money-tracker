# Copy to .env.local and fill the required public app configuration.
# This file contains placeholders only. Never commit real credentials.
# Supabase project URL and public anon key (RLS must protect all user data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Full app origin for auth email callbacks; use your local origin during development.
NEXT_PUBLIC_SITE_URL=

# Optional dev-only additional hostnames, comma separated; trim spaces.
# Hostnames only: no scheme, port or path. Empty uses Next.js defaults.
# Example hostnames: dev.example.test,*.dev.example.test
ALLOWED_DEV_ORIGINS=

# Server-only provider keys. Never prefix these with NEXT_PUBLIC_.
# Groq/Gemini are disabled unless the key is set AND the corresponding flag is true.
# Set a flag true only after confirming that account/project is still free tier.
GROQ_API_KEY=
AI_GROQ_FREE_TIER=false
GEMINI_API_KEY=
AI_GEMINI_FREE_TIER=false
OPENROUTER_API_KEY=
# Empty defaults to openrouter/free. Only openrouter/free or a :free model is used.
OPENROUTER_FREE_MODEL=
# Optional independent OCR.space check; signed image URLs expire after 180 seconds.
OCR_API_KEY=

# Framework/hosting-managed values: do not override in normal .env.local setup.
# NODE_ENV is set by Next.js scripts; VERCEL is injected by Vercel hosting.
# NODE_ENV=
# VERCEL=

# Existing local fixture hooks ONLY; not required for the app or npm test.
# Keep absent in production. The committed demo launcher/Playwright config is missing.
# E2E_REPORT_FIXTURE=
# FINANCE_DEMO=
# NEXT_PUBLIC_SUPABASE_BROWSER_PROXY=
# Test fixture script inputs (tests/report-supabase.mjs), not production app settings:
# FINANCE_DEMO_BACKUP=
# FINANCE_DEMO_STATE_FILE=
# FINANCE_FIXTURE_PORT=
